

# Cargo outputs are reproducible and never belong in the repository.
/target/

# Python caches from the brand tools in design/brand/tools.
__pycache__/

# Agent worktrees are local checkouts of branches, not project files.
# .claude/skills is project content and stays tracked.
/.claude/worktrees/

# JetBrains IDE settings are per machine.
/.idea/

# The plugin host's test plugins build into the test target folder; a manual build lands here.
/crates/syrinx-plugin-host/tests/fixtures/plugins/target/
